{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schemas/system-signal.schema.json",
  "title": "SystemSignal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "signal_id",
    "source",
    "timestamp",
    "risk_score",
    "host",
    "service",
    "process",
    "event_type",
    "related_ips",
    "indicators"
  ],
  "properties": {
    "signal_id": { "type": "string" },
    "source": { "const": "ebpf_detector" },
    "timestamp": { "type": "string", "format": "date-time" },
    "risk_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "host": { "type": "string" },
    "service": { "type": "string" },
    "process": { "type": "string" },
    "event_type": { "type": "string" },
    "related_ips": {
      "type": "array",
      "items": { "type": "string" }
    },
    "indicators": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
