{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schemas/incident.schema.json",
  "title": "Incident",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "incident_id",
    "timestamp",
    "verdict",
    "severity",
    "confidence",
    "financial_signal_id",
    "infrastructure_signal_id",
    "affected_accounts",
    "summary",
    "evidence",
    "recommended_actions",
    "status"
  ],
  "properties": {
    "incident_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "verdict": { "type": "string" },
    "severity": {
      "type": "string",
      "enum": ["informational", "suspicious", "high", "critical"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "financial_signal_id": { "type": "string" },
    "infrastructure_signal_id": { "type": "string" },
    "affected_accounts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "summary": { "type": "string" },
    "evidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "recommended_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "target", "approval_required", "status"],
        "properties": {
          "action": { "type": "string" },
          "target": { "type": "string" },
          "approval_required": { "type": "boolean" },
          "status": { "type": "string" }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["monitoring", "awaiting_approval", "contained"]
    }
  }
}
