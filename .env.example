# auto: prefer services and fall back; fixture: always offline demo; required: no fallback
ARGUS_DETECTOR_MODE=auto
GRAPH_DETECTOR_URL=http://127.0.0.1:8001
EBPF_DETECTOR_URL=http://127.0.0.1:8002
DETECTOR_TIMEOUT_SECONDS=2.5
ARGUS_DB_PATH=data/argus.db
# Comma-separated exact origins when hosting the frontend separately (e.g. Vercel).
ARGUS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
FRAUD_ALERT_THRESHOLD=0.70
SCAM_ALERT_THRESHOLD=70.0
ANALYSIS_WINDOW_MINUTES=15
ANALYSIS_MAX_TRANSACTIONS=100

# Detector-specific behavior
ARGUS_EBPF_MODE=replay
# ARGUS_GRAPH_BASELINE=data/normal/transactions.json

# Manual frontend: set in frontend/.env.local to override localhost:8000.
# Docker: leave blank for the same-origin Nginx API/WebSocket proxy.
# Vercel: set to the public HTTPS backend origin, then rebuild.
VITE_API_BASE_URL=
