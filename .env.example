# auto: prefer services and fall back; fixture: always offline demo; required: no fallback
ARGUS_DETECTOR_MODE=auto
GRAPH_DETECTOR_URL=http://127.0.0.1:8001
EBPF_DETECTOR_URL=http://127.0.0.1:8002
DETECTOR_TIMEOUT_SECONDS=2.5

# Detector-specific behavior
ARGUS_EBPF_MODE=replay
# ARGUS_GRAPH_BASELINE=data/normal/transactions.json

# Frontend (set in frontend/.env.local only when overriding the default)
VITE_API_BASE_URL=http://127.0.0.1:8000
